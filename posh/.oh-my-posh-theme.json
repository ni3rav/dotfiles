{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "palette": {
    "white": "#f2f4f8",
    "cyan": "#3ddbd9",
    "blue": "#33b1ff",
    "green": "#42be65",
    "orange": "#ee5396",
    "purple": "#be95ff",
    "closer": "#be95ff",
    "less" : "#f2f4f850"
  },
  "blocks": [
    {
      "alignment": "left",
      "segments": [
       {
          "foreground": "p:blue",
          "style": "plain",
          "template": "{{ if .Venv }}\ue73c {{ .Venv }} {{ else }}\ue73c {{ .Full }}{{ end }} ",
          "type": "python"
        },
        {
          "foreground": "p:orange",
          "style": "plain",
          "template": "\ue256 {{ .Full }} ",
          "type": "java"
        },
        {
          "foreground": "p:cyan",
          "options": {
            "folder_icon": "",
            "folder_separator_icon": "/",
            "home_icon": "~",
            "style": "full"
          },
          "style": "plain",
          "template": "{{ .Path }} ",
          "type": "path"
        },
        {
          "foreground": "p:less",
	  "options": {
            "branch_icon": "",
            "cherry_pick_icon": "",
            "commit_icon": "",
            "fetch_status": false,
            "fetch_upstream_icon": false,
            "merge_icon": "",
            "no_commits_icon": "",
            "rebase_icon": "",
            "revert_icon": "",
            "tag_icon": ""
          },

	  "template": "{{ .HEAD }} ",
          "style": "plain",
          "type": "git"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "style": "plain",
          "foreground": "p:closer",
          "template": "\uf054",
          "type": "text"
        }
      ],
      "type": "prompt"
    }
  ],
  "final_space": true,
  "version": 3
}
