EOF
  printf '\n'
  printf '  1  apply theme\n'
  printf '  2  create theme\n'
  printf '\n'
  printf '  q  quit\n'
  printf '\n'
  printf '  saved in %s\n' "$THEMES"
  printf '\n'
}

main() {
  local choice
  trap 'trap - ERR; printf "\n"; exit 0' INT
  trap 'note "unexpected error on line $LINENO"' ERR
  while true; do
    show_menu
    read -r -p "  choose: " choice || exit 0
    case $choice in
      1) choose_theme ;;
      2) create_theme ;;
      q|Q) exit 0 ;;
      *) ;;
    esac
  done
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  main "$@"
fi
