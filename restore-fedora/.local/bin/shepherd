#!/usr/bin/env bash
# Shepherd applies a theme pack from extra/themes, or creates one.
# Packs are not stowed. This script is.

set -u

SCRIPT_PATH=$(readlink -f "${BASH_SOURCE[0]}")
REPO=$(cd "$(dirname "$SCRIPT_PATH")/../../.." && pwd)
THEMES="$REPO/extra/themes"
STATE_DIR=${XDG_STATE_HOME:-$HOME/.local/state}/shepherd
FIREFOX_ROOT=$HOME/.config/mozilla/firefox
HELIUM_PREFS=$HOME/.config/net.imput.helium/Default/Preferences

note() { printf '  %s\n' "$*"; }
pause() { read -r -p "  enter to return " _ || exit 0; }
PY_ERR=

py() {
  local status=0 errfile
  PY_ERR=
  errfile=$(mktemp) || { PY_ERR="could not create a temp file"; return 1; }
  PY_OUT=$(python3 - "$@" 2>"$errfile" <<'PY'
import base64, configparser, hashlib, io, json, os, re, shutil, sys, zipfile
from pathlib import Path

def _quiet(kind, exc, _tb):
    if isinstance(exc, OSError) and getattr(exc, "filename", None):
        print(f"could not read {exc.filename}", file=sys.stderr)
        return
    text = str(exc).strip() or kind.__name__
    print(text, file=sys.stderr)

sys.excepthook = _quiet

def chromium_id(raw: bytes) -> str:
    digest = hashlib.sha256(raw).digest()[:16]
    return "".join(chr(ord("a") + int(c, 16)) for c in digest.hex())

def write_text(path: Path, text: str) -> None:
    path.write_text(text)

cmd = sys.argv[1]
if cmd == "set-ghostty":
    path, theme = Path(sys.argv[2]), sys.argv[3]
    lines = path.read_text().splitlines()
    out, found = [], False
    for line in lines:
        if re.match(r"^theme\s*=", line):
            out.append(f"theme = {theme}")
            found = True
        else:
            out.append(line)
    if not found:
        out.append(f"theme = {theme}")
    write_text(path, "\n".join(out) + "\n")

elif cmd == "set-vicinae":
    path, theme = Path(sys.argv[2]), sys.argv[3]
    text = path.read_text()
    new, n = re.subn(
        r'("theme"\s*:\s*\{.*?"dark"\s*:\s*\{.*?"name"\s*:\s*")[^"]*(")',
        lambda m: m.group(1) + theme + m.group(2),
        text,
        count=1,
        flags=re.S,
    )
    if n != 1:
        sys.exit("vicinae theme name was not found")
    write_text(path, new)

elif cmd == "set-editor":
    path, theme = Path(sys.argv[2]), sys.argv[3]
    with path.open(newline="") as handle:
        text = handle.read()
    new, n = re.subn(
        r'("workbench\.colorTheme"\s*:\s*")[^"]*(")',
        lambda m: m.group(1) + theme + m.group(2),
        text,
        count=1,
    )
    if n != 1:
        sys.exit("workbench.colorTheme was not found")
    with path.open("w", newline="") as handle:
        handle.write(new)

elif cmd == "set-starship":
    path, accent = Path(sys.argv[2]), sys.argv[3]
    text = path.read_text()
    keys = ("success_symbol", "error_symbol", "vimcmd_symbol")

    def line(src: str) -> str:
        for key in keys:
            if re.match(rf"^\s*{key}\s*=", src):
                return re.sub(r"\((bold )[^)]+\)", rf"(\1{accent})", src, count=1)
        if re.match(r"^\s*style\s*=", src):
            return re.sub(r'"(bold )[^"]+"', rf'"\1{accent}"', src, count=1)
        return src

    write_text(path, "\n".join(line(src) for src in text.splitlines()) + "\n")

elif cmd == "firefox-profile":
    cp = configparser.ConfigParser()
    cp.read(sys.argv[2])
    root = str(Path(sys.argv[2]).parent)
    chosen = ""
    for section in cp.sections():
        if section.startswith("Install") and cp.has_option(section, "Default"):
            chosen = cp.get(section, "Default")
            break
    if not chosen:
        for section in cp.sections():
            if cp.has_option(section, "Default") and cp.get(section, "Default") == "1":
                chosen = cp.get(section, "Path")
                break
    if not chosen or not (Path(root) / chosen).is_dir():
        sys.exit("firefox profile was not found")
    print(Path(root) / chosen)

elif cmd == "firefox-id":
    addon = Path(sys.argv[2])
    if addon.is_dir():
        manifest = json.loads((addon / "manifest.json").read_text())
    else:
        with zipfile.ZipFile(addon) as archive:
            manifest = json.loads(archive.read("manifest.json"))
    gecko = (manifest.get("browser_specific_settings") or manifest.get("applications") or {}).get("gecko") or {}
    addon_id = gecko.get("id") or ""
    if not addon_id and not addon.is_dir():
        addon_id = addon.stem
    if not addon_id or "/" in addon_id or "\\" in addon_id or addon_id in {".", ".."}:
        sys.exit("firefox addon id is not usable")
    print(addon_id)

elif cmd == "firefox-userjs":
    path, addon_id = Path(sys.argv[2]), sys.argv[3]
    block = (
        "// shepherd:start\n"
        f'user_pref("extensions.activeThemeID", "{addon_id}");\n'
        "// shepherd:end\n"
    )
    text = path.read_text() if path.exists() else ""
    if "// shepherd:start" in text:
        text = re.sub(r"// shepherd:start\n.*?// shepherd:end\n", block, text, count=1, flags=re.S)
    else:
        if text and not text.endswith("\n"):
            text += "\n"
        if text:
            text += "\n"
        text += block
    write_text(path, text)

elif cmd == "extract-archive":
    archive, dest = Path(sys.argv[2]), Path(sys.argv[3])
    raw = archive.read_bytes()
    if raw[:4] == b"Cr24":
        version = int.from_bytes(raw[4:8], "little")
        if version == 2:
            pub = int.from_bytes(raw[8:12], "little")
            sig = int.from_bytes(raw[12:16], "little")
            raw = raw[16 + pub + sig :]
        elif version == 3:
            header = int.from_bytes(raw[8:12], "little")
            raw = raw[12 + header :]
        else:
            sys.exit(f"unknown crx version {version}")
    if dest.exists():
        shutil.rmtree(dest)
    dest.mkdir(parents=True)
    with zipfile.ZipFile(io.BytesIO(raw)) as opened:
        root = dest.resolve()
        for info in opened.infolist():
            target = (root / info.filename).resolve()
            if target != root and root not in target.parents:
                raise ValueError("archive path leaves the theme folder")
        opened.extractall(root)

elif cmd == "helium-install":
    prefs_path, ext_dir = Path(sys.argv[2]), Path(sys.argv[3]).resolve()
    manifest = json.loads((ext_dir / "manifest.json").read_text())
    data = json.loads(prefs_path.read_text())
    backup = prefs_path.with_name("Preferences.shepherd-bak")
    if not backup.exists():
        shutil.copy2(prefs_path, backup)
    version = str(manifest.get("version") or "1.0.0")
    if manifest.get("key"):
        eid = chromium_id(base64.b64decode(manifest["key"]))
        dest = prefs_path.parent / "Extensions" / eid / f"{version}_0"
        if dest.exists():
            shutil.rmtree(dest)
        shutil.copytree(ext_dir, dest)
        location = 1
        path_value = f"{eid}/{version}_0"
        pack = str(dest)
        flags = 1
    else:
        eid = chromium_id(str(ext_dir).encode())
        location = 4
        path_value = str(ext_dir)
        pack = str(ext_dir)
        flags = 0
        data.setdefault("extensions", {}).setdefault("ui", {})["developer_mode"] = True
    empty = {"api": [], "explicit_host": [], "manifest_permissions": [], "scriptable_host": []}
    settings = data.setdefault("extensions", {}).setdefault("settings", {})
    settings[eid] = {
        "active_permissions": empty,
        "creation_flags": flags,
        "disable_reasons": [],
        "from_webstore": False,
        "granted_permissions": empty,
        "location": location,
        "manifest": manifest,
        "path": path_value,
        "state": 1,
        "was_installed_by_default": False,
    }
    data.setdefault("extensions", {})["theme"] = {"id": eid, "pack": pack, "system_theme": 0}
    write_text(prefs_path, json.dumps(data, separators=(",", ":"), ensure_ascii=False))
    print(eid)
    print("keyed" if manifest.get("key") else "unpacked")

elif cmd == "set-gtk-name":
    theme_name, gtk3, gtk4, gtk2 = sys.argv[2:6]

    def ini_theme(path: Path) -> None:
        path.parent.mkdir(parents=True, exist_ok=True)
        text = path.read_text() if path.exists() else "[Settings]\n"
        if re.search(r"(?m)^gtk-theme-name=.*$", text):
            text = re.sub(r"(?m)^gtk-theme-name=.*$", f"gtk-theme-name={theme_name}", text, count=1)
        else:
            if text and not text.endswith("\n"):
                text += "\n"
            text += f"gtk-theme-name={theme_name}\n"
        write_text(path, text)

    ini_theme(Path(gtk3))
    ini_theme(Path(gtk4))
    rc = Path(gtk2)
    text = rc.read_text() if rc.exists() else ""
    line = f'gtk-theme-name="{theme_name}"'
    if re.search(r"(?m)^gtk-theme-name=.*$", text):
        text = re.sub(r"(?m)^gtk-theme-name=.*$", line, text, count=1)
    else:
        if text and not text.endswith("\n"):
            text += "\n"
        text += line + "\n"
    write_text(rc, text)

elif cmd == "accent-from-colors":
    sections = {}
    section = ""
    for raw in Path(sys.argv[2]).read_text().splitlines():
        stripped = raw.strip()
        if stripped.startswith("[") and stripped.endswith("]"):
            section = stripped[1:-1]
            continue
        if "=" not in stripped or not section:
            continue
        key, value = stripped.split("=", 1)
        parts = []
        for piece in value.split(",")[:3]:
            piece = piece.strip()
            if not piece.lstrip("-").isdigit():
                parts = []
                break
            parts.append(int(piece))
        if len(parts) == 3:
            sections.setdefault(section, {})[key] = tuple(parts)

    def channel(value: float) -> float:
        value = value / 255
        if value <= 0.04045:
            return value / 12.92
        return ((value + 0.055) / 1.055) ** 2.4

    def luminance(rgb: tuple[int, int, int]) -> float:
        return 0.2126 * channel(rgb[0]) + 0.7152 * channel(rgb[1]) + 0.0722 * channel(rgb[2])

    def contrast(one: tuple[int, int, int], other: tuple[int, int, int]) -> float:
        dark, light = sorted((luminance(one), luminance(other)))
        return (light + 0.05) / (dark + 0.05)

    def hsl(rgb: tuple[int, int, int]) -> tuple[float, float, float]:
        red, green, blue = (c / 255 for c in rgb)
        hi, lo = max(red, green, blue), min(red, green, blue)
        light = (hi + lo) / 2
        if hi == lo:
            return 0.0, 0.0, light
        delta = hi - lo
        sat = delta / (1 - abs(2 * light - 1))
        if hi == red:
            hue = ((green - blue) / delta) % 6
        elif hi == green:
            hue = (blue - red) / delta + 2
        else:
            hue = (red - green) / delta + 4
        return hue * 60, sat, light

    def rgb_from(hue: float, sat: float, light: float) -> tuple[int, int, int]:
        chroma = (1 - abs(2 * light - 1)) * sat
        mixed = chroma * (1 - abs((hue / 60) % 2 - 1))
        match = light - chroma / 2
        hue = hue % 360
        if hue < 60:
            red, green, blue = chroma, mixed, 0
        elif hue < 120:
            red, green, blue = mixed, chroma, 0
        elif hue < 180:
            red, green, blue = 0, chroma, mixed
        elif hue < 240:
            red, green, blue = 0, mixed, chroma
        elif hue < 300:
            red, green, blue = mixed, 0, chroma
        else:
            red, green, blue = chroma, 0, mixed
        return tuple(round((c + match) * 255) for c in (red, green, blue))

    backgrounds = []
    for name in ("Colors:Window", "Colors:View"):
        rgb = sections.get(name, {}).get("BackgroundNormal")
        if rgb:
            backgrounds.append(rgb)
    if not backgrounds:
        backgrounds = [(0, 0, 0)]

    def readable(rgb: tuple[int, int, int]) -> bool:
        return all(contrast(rgb, bg) >= 4.5 for bg in backgrounds)

    roles = (
        ("Colors:Selection", "BackgroundNormal"),
        ("Colors:Window", "DecorationFocus"),
        ("Colors:View", "DecorationFocus"),
        ("Colors:Button", "DecorationFocus"),
        ("Colors:View", "ForegroundLink"),
        ("Colors:Window", "ForegroundLink"),
        ("Colors:Selection", "ForegroundLink"),
        ("Colors:Button", "ForegroundLink"),
    )
    chosen = None
    for name, key in roles:
        rgb = sections.get(name, {}).get(key)
        if rgb and readable(rgb):
            chosen = rgb
            break
    if chosen is None:
        chosen = sections.get("Colors:Selection", {}).get("BackgroundNormal")
        if chosen is None:
            sys.exit("selection color was not found")
        hue, sat, _light = hsl(chosen)
        best = chosen
        best_gap = min(contrast(chosen, bg) for bg in backgrounds)
        for step in range(5, 96):
            candidate = rgb_from(hue, sat, step / 100)
            gap = min(contrast(candidate, bg) for bg in backgrounds)
            if gap > best_gap:
                best, best_gap = candidate, gap
            if gap >= 4.5:
                best = candidate
                break
        chosen = best
    print("#{:02x}{:02x}{:02x}".format(*chosen))

elif cmd == "vsix-theme":
    label = ""
    with zipfile.ZipFile(sys.argv[2]) as archive:
        for info in archive.namelist():
            if not info.endswith("package.json") or info.count("/") > 2:
                continue
            data = json.loads(archive.read(info))
            themes = (data.get("contributes") or {}).get("themes") or []
            if themes:
                label = themes[0].get("label") or themes[0].get("id") or ""
                break
    if not label:
        sys.exit("vsix has no color theme")
    print(label)

else:
    sys.exit(f"unknown command {cmd}")
PY
  ) || status=$?
  if (( status != 0 )); then
    PY_ERR=$(<"$errfile")
    rm -f "$errfile"
    [[ -n $PY_ERR ]] || PY_ERR="command failed"
    return "$status"
  fi
  rm -f "$errfile"
  if [[ -n ${PY_OUT:-} ]]; then
    printf '%s\n' "$PY_OUT"
  fi
}

conf_value() {
  local file=$1 key=$2
  awk -F= -v key="$key" '$1 == key { sub(/^[^=]*=/, ""); print; exit }' "$file"
}

list_themes() {
  [[ -d $THEMES ]] || return 0
  local dir
  shopt -s nullglob
  for dir in "$THEMES"/*/; do
    [[ -f ${dir}theme.conf ]] || continue
    basename "$dir"
  done
  shopt -u nullglob
}

addon_source() {
  local root=$1
  local -a dirs=() archives=()
  local entry
  [[ -d $root ]] || return 1
  if [[ -f $root/manifest.json ]]; then
    printf '%s\n' "$root"
    return 0
  fi
  shopt -s nullglob
  for entry in "$root"/*/; do
    [[ -f ${entry}manifest.json ]] && dirs+=("${entry%/}")
  done
  archives=("$root"/*.xpi "$root"/*.zip "$root"/*.crx)
  shopt -u nullglob
  if (( ${#dirs[@]} + ${#archives[@]} != 1 )); then
    return 1
  fi
  if (( ${#dirs[@]} == 1 )); then
    printf '%s\n' "${dirs[0]}"
  else
    printf '%s\n' "${archives[0]}"
  fi
}

first_wallpaper() {
  local root=$1
  [[ -d $root ]] || return 1
  find "$root" -maxdepth 1 -type f \
    \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' \) \
    | sort | head -n 1
}

materialize_addon() {
  local source=$1 dest_root=$2
  if [[ -d $source ]]; then
    printf '%s\n' "$source"
    return 0
  fi
  rm -rf "$dest_root"
  py extract-archive "$source" "$dest_root" || return 1
  if [[ -f $dest_root/manifest.json ]]; then
    printf '%s\n' "$dest_root"
    return 0
  fi
  local nested
  nested=$(find "$dest_root" -mindepth 2 -maxdepth 2 -name manifest.json | head -n 1)
  [[ -n $nested ]] || return 1
  printf '%s\n' "$(dirname "$nested")"
}

apply_editors() {
  local theme=$1 file
  for file in \
    "$HOME/.config/Code/User/settings.json" \
    "$HOME/.config/Cursor/User/settings.json"
  do
    if [[ -f $file ]]; then
      if py set-editor "$file" "$theme"; then
        note "editor: $(basename "$(dirname "$(dirname "$file")")") → $theme"
      else
        note "editor: ${PY_ERR:-could not update}"
      fi
    else
      note "editor missing: $file"
    fi
  done
}

apply_firefox() {
  local pack=$1 source id profile
  source=$(addon_source "$pack/firefox") || {
    note "firefox: no addon in this pack"
    return 0
  }
  [[ -f $FIREFOX_ROOT/profiles.ini ]] || {
    note "firefox: profiles.ini is missing"
    return 0
  }
  profile=$(py firefox-profile "$FIREFOX_ROOT/profiles.ini") || {
    note "firefox: profile was not found"
    return 0
  }
  id=$(py firefox-id "$source") || {
    note "firefox: addon id was not found"
    return 0
  }
  mkdir -p "$profile/extensions" || { note "firefox: could not create the extensions folder"; return 0; }
  if [[ -d $source ]]; then
    rm -rf "$profile/extensions/$id" || { note "firefox: could not replace the old addon"; return 0; }
    cp -a "$source" "$profile/extensions/$id" || { note "firefox: could not copy the addon"; return 0; }
  else
    cp -a "$source" "$profile/extensions/$id.xpi" || { note "firefox: could not copy the addon"; return 0; }
  fi
  if py firefox-userjs "$profile/user.js" "$id"; then
    note "firefox: $id on next launch"
  else
    note "firefox: ${PY_ERR:-could not select the addon}"
  fi
}

apply_helium() {
  local pack=$1 source root installed_text
  local -a installed=()
  source=$(addon_source "$pack/helium") || {
    note "helium: no addon in this pack"
    return 0
  }
  [[ -f $HELIUM_PREFS ]] || {
    note "helium: profile is missing"
    return 0
  }
  if pgrep -x helium >/dev/null 2>&1 || pgrep -x helium-bin >/dev/null 2>&1; then
    note "helium is open. quit it, then apply this theme again"
    return 0
  fi
  root=$(materialize_addon "$source" "$STATE_DIR/helium-src") || {
    note "helium: ${PY_ERR:-addon could not be read}"
    return 0
  }
  if installed_text=$(py helium-install "$HELIUM_PREFS" "$root"); then
    mapfile -t installed <<< "$installed_text"
    if [[ -n ${installed[0]:-} ]]; then
      note "helium: ${installed[0]} on next launch"
      [[ ${installed[1]:-} == unpacked ]] && note "helium: developer mode enabled for this unpacked theme"
    else
      note "helium: preferences were not written"
    fi
  else
    note "helium: ${PY_ERR:-preferences were not written}"
  fi
}

apply_theme() {
  local name=$1
  local dir=$THEMES/$name
  local conf=$dir/theme.conf
  local accent ghostty colors scheme wallpaper wall fresh="" out=""
  [[ -f $conf ]] || { note "no theme.conf in $name"; return 1; }

  accent=$(conf_value "$conf" accent)
  ghostty=$(conf_value "$conf" ghostty)

  note "applying $name"

  colors=$(find "$dir" -maxdepth 1 -name '*.colors' | sort | head -n 1)
  if [[ -n $colors ]]; then
    fresh=$(py accent-from-colors "$colors") || fresh=""
    [[ -n $fresh ]] && accent=$fresh
    scheme=$(basename "$colors" .colors)
    if mkdir -p "$HOME/.local/share/color-schemes" \
      && cp -a "$colors" "$HOME/.local/share/color-schemes/$scheme.colors"; then
      if out=$(plasma-apply-colorscheme "$scheme" 2>&1); then
        note "kde colors: $scheme"
      else
        note "kde colors: saved $(basename "$colors"), plasma did not apply ${scheme:-the scheme}"
        [[ -n $out ]] && note "$out"
      fi
    else
      note "kde colors: could not install $(basename "$colors")"
    fi
  else
    note "kde colors: no .colors file in this pack"
  fi

  wallpaper=$(first_wallpaper "$dir/wallpapers" || true)
  if [[ -n $wallpaper ]]; then
    wall=$(readlink -f "$wallpaper" 2>/dev/null || true)
    if [[ -n $wall ]] && out=$(plasma-apply-wallpaperimage "$wall" 2>&1); then
      note "wallpaper: $(basename "$wall")"
    else
      note "wallpaper: plasma did not apply ${wall:-the image}"
      [[ -n $out ]] && note "$out"
    fi
  else
    note "wallpaper: none in this pack"
  fi

  if [[ -n $ghostty && -f $HOME/.config/ghostty/config ]]; then
    if py set-ghostty "$HOME/.config/ghostty/config" "$ghostty"; then
      note "ghostty: $ghostty"
    else
      note "ghostty: ${PY_ERR:-could not update}"
    fi
  else
    note "ghostty: skipped"
  fi

  apply_vicinae "$dir"
  apply_vscode "$dir"

  if [[ -n $accent && -f $HOME/.config/starship.toml ]]; then
    if py set-starship "$HOME/.config/starship.toml" "$accent"; then
      note "starship: $accent"
    else
      note "starship: ${PY_ERR:-could not update}"
    fi
  else
    note "starship: skipped"
  fi

  apply_firefox "$dir"
  apply_helium "$dir"
  apply_gtk "$dir"

  mkdir -p "$STATE_DIR"
  printf '%s\n' "$name" > "$STATE_DIR/current"
  note "icons stay Kaze-dark"
}

choose_theme() {
  local -a themes=()
  local line current="" choice
  while IFS= read -r line; do
    [[ -n $line ]] && themes+=("$line")
  done < <(list_themes | sort)

  if (( ${#themes[@]} == 0 )); then
    note "no themes yet. create one first"
    pause
    return
  fi

  [[ -f $STATE_DIR/current ]] && current=$(<"$STATE_DIR/current")
  [[ -n $current ]] && note "current: $current"
  echo
  local i
  for i in "${!themes[@]}"; do
    printf '  %s  %s\n' "$((i + 1))" "${themes[$i]}"
  done
  echo
  read -r -p "  theme: " choice || exit 0
  if [[ $choice =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= ${#themes[@]} )); then
    echo
    apply_theme "${themes[$((choice - 1))]}"
  else
    note "no theme selected"
  fi
  echo
  pause
}

apply_gtk() {
  local dir=$1 theme_name src="" install_name
  theme_name=$(conf_value "$dir/theme.conf" gtk)
  if [[ -f $dir/gtk/index.theme || -d $dir/gtk/gtk-3.0 || -d $dir/gtk/gtk-4.0 || -d $dir/gtk/gtk-2.0 ]]; then
    src=$dir/gtk
    install_name=${theme_name:-$(basename "$dir")}
  elif [[ -d $dir/gtk ]]; then
    local child
    shopt -s nullglob
    for child in "$dir/gtk"/*/; do
      if [[ -f ${child}index.theme || -d ${child}gtk-3.0 || -d ${child}gtk-4.0 ]]; then
        src=${child%/}
        install_name=$(basename "$src")
        break
      fi
    done
    shopt -u nullglob
  fi
  if [[ -n $src ]]; then
    [[ -n $install_name ]] || install_name=$(basename "$src")
    rm -rf "$HOME/.themes/$install_name"
    mkdir -p "$HOME/.themes/$install_name" || { note "gtk: could not create ~/.themes/$install_name"; return 0; }
    cp -a "$src"/. "$HOME/.themes/$install_name/" || { note "gtk: could not install $install_name"; return 0; }
    theme_name=$install_name
  fi
  if [[ -z $theme_name ]]; then
    note "gtk: left as it is"
    return 0
  fi
  if [[ -n $src && ! -d $src/gtk-4.0 ]]; then
    note "gtk: no gtk-4.0 folder, GTK 4 keeps this theme name"
  fi
  if py set-gtk-name "$theme_name" \
    "$HOME/.config/gtk-3.0/settings.ini" \
    "$HOME/.config/gtk-4.0/settings.ini" \
    "$HOME/.gtkrc-2.0"
  then
    if ! gsettings set org.gnome.desktop.interface gtk-theme "$theme_name" 2>/dev/null; then
      note "gtk: gsettings was left unchanged"
    fi
    note "gtk: $theme_name"
  else
    note "gtk: ${PY_ERR:-could not set the theme}"
  fi
}

ask() {
  local prompt=$1 reply
  read -r -e -p "  $prompt " reply || exit 0
  printf '%s' "$reply"
}

pick_file() {
  local title=$1 filter=$2 result
  command -v kdialog >/dev/null || { note "kdialog is missing"; return 1; }
  result=$(kdialog --title "$title" --getopenfilename "$HOME" "$filter") || return 1
  [[ -n $result && -f $result ]] || return 1
  printf '%s\n' "$result"
}

pick_files() {
  local title=$1 filter=$2
  command -v kdialog >/dev/null || { note "kdialog is missing"; return 1; }
  kdialog --title "$title" --multiple --separate-output --getopenfilename "$HOME" "$filter"
}

pick_dir() {
  local title=$1 result
  command -v kdialog >/dev/null || { note "kdialog is missing"; return 1; }
  result=$(kdialog --title "$title" --getexistingdirectory "$HOME") || return 1
  [[ -n $result && -d $result ]] || return 1
  printf '%s\n' "$result"
}

save_vicinae_files() {
  local dest=$1 file icon_rel icon_src
  shift
  mkdir -p "$dest" || return 1
  for file in "$@"; do
    [[ -f $file ]] || continue
    cp -a "$file" "$dest/" || return 1
    [[ $file == *.toml ]] || continue
    icon_rel=$(awk -F'"' '/^[[:space:]]*icon[[:space:]]*=/ { print $2; exit }' "$file")
    [[ -n $icon_rel && $icon_rel != /* ]] || continue
    icon_src="$(dirname "$file")/$icon_rel"
    [[ -f $icon_src ]] || continue
    mkdir -p "$dest/$(dirname "$icon_rel")" || return 1
    cp -a "$icon_src" "$dest/$icon_rel" || return 1
  done
}

apply_vicinae() {
  local dir=$1 name="" toml
  if [[ -d $dir/vicinae ]]; then
    mkdir -p "$HOME/.config/vicinae/themes" || { note "vicinae: could not create the themes folder"; return 0; }
    cp -a "$dir/vicinae/." "$HOME/.config/vicinae/themes/" || { note "vicinae: could not copy the theme"; return 0; }
  fi
  name=$(conf_value "$dir/theme.conf" vicinae)
  if [[ -z $name && -d $dir/vicinae ]]; then
    toml=$(find "$dir/vicinae" -maxdepth 1 -name '*.toml' | sort | head -n 1)
    [[ -n $toml ]] && name=$(basename "$toml" .toml)
  fi
  if [[ -n $name && -f $HOME/.config/vicinae/settings.json ]]; then
    if py set-vicinae "$HOME/.config/vicinae/settings.json" "$name"; then
      note "vicinae: $name"
    else
      note "vicinae: ${PY_ERR:-could not update}"
    fi
  else
    note "vicinae: skipped"
  fi
}

apply_vscode() {
  local dir=$1 vsix="" label
  label=$(conf_value "$dir/theme.conf" vscode)
  vsix=$(find "$dir/vscode" -maxdepth 1 -name '*.vsix' 2>/dev/null | sort | head -n 1)
  if [[ -z $vsix && -z $label ]]; then
    note "editors: skipped"
    return 0
  fi
  if [[ -n $vsix ]]; then
    if [[ -z $label ]]; then
      label=$(py vsix-theme "$vsix") || label=""
    fi
    if command -v code >/dev/null; then
      if code --install-extension "$vsix" --force >/dev/null; then
        note "vscode: installed $(basename "$vsix")"
      else
        note "vscode: could not install the vsix"
      fi
    else
      note "vscode: code command is missing"
    fi
    if command -v cursor >/dev/null; then
      if cursor --install-extension "$vsix" --force >/dev/null; then
        note "cursor: installed $(basename "$vsix")"
      else
        note "cursor: could not install the vsix"
      fi
    else
      note "cursor: command is missing"
    fi
  fi
  if [[ -n $label ]]; then
    apply_editors "$label"
  else
    note "editors: theme name was not found"
  fi
}

copy_images() {
  local src=$1 dest=$2 img status=0
  shopt -s nullglob nocaseglob
  for img in "$src"/*.png "$src"/*.jpg "$src"/*.jpeg "$src"/*.webp; do
    cp -a "$img" "$dest/" || status=1
  done
  shopt -u nullglob nocaseglob
  return "$status"
}

create_theme() {
  local name accent="" ghostty="" vicinae_name="" vscode_label="" colors="" gtk="" firefox="" helium=""
  local dir gtk_name="" file toml
  local -a vicinae_files=() wall_files=()

  name=$(ask "theme name:")
  if [[ ! $name =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
    note "use a name of letters, numbers, dots, dashes"
    pause
    return
  fi
  dir=$THEMES/$name
  if [[ -e $dir ]]; then
    local replace
    replace=$(ask "theme exists. replace its config? [y/N]")
    [[ $replace == [yY] ]] || { pause; return; }
  fi

  ghostty=$(ask "ghostty theme, empty to skip:")
  note "vicinae theme files. cancel to skip"
  mapfile -t vicinae_files < <(pick_files "Vicinae theme" "*.toml *.png *.svg *.jpg *.webp|Vicinae theme" || true)
  note "kde color scheme. cancel to skip"
  colors=$(pick_file "KDE color scheme" "*.colors|KDE color schemes" || true)
  if [[ -n $colors ]]; then
    if accent=$(py accent-from-colors "$colors"); then
      note "starship color: $accent"
    else
      accent=""
      note "starship: ${PY_ERR:-selection color was not found}"
    fi
  fi
  note "wallpapers. cancel to skip"
  mapfile -t wall_files < <(pick_files "Wallpapers" "*.png *.jpg *.jpeg *.webp|Images" || true)
  note "gtk theme folder. cancel to skip"
  gtk=$(pick_dir "GTK theme" || true)
  note "vscode theme vsix. cancel to skip"
  local vsix=""
  vsix=$(pick_file "VS Code theme" "*.vsix|VS Code theme" || true)
  note "firefox addon. cancel to skip"
  firefox=$(pick_file "Firefox addon" "*.xpi *.zip|Firefox addon" || true)
  note "helium addon. cancel to skip"
  helium=$(pick_file "Helium addon" "*.crx *.zip|Helium addon" || true)

  if [[ -d $gtk ]]; then
    gtk_name=$(basename "$gtk")
  fi
  if (( ${#vicinae_files[@]} > 0 )); then
    for toml in "${vicinae_files[@]}"; do
      if [[ $toml == *.toml ]]; then
        vicinae_name=$(basename "$toml" .toml)
        break
      fi
    done
  fi
  if [[ -n $vsix ]]; then
    vscode_label=$(py vsix-theme "$vsix" || true)
    [[ -n $vscode_label ]] || note "editors: ${PY_ERR:-vsix has no color theme}"
  fi

  mkdir -p "$dir" || { note "could not create $dir"; pause; return; }
  {
    [[ -n $ghostty ]] && printf 'ghostty=%s\n' "$ghostty"
    [[ -n $vicinae_name ]] && printf 'vicinae=%s\n' "$vicinae_name"
    [[ -n $accent ]] && printf 'accent=%s\n' "$accent"
    [[ -n $gtk_name ]] && printf 'gtk=%s\n' "$gtk_name"
    [[ -n $vscode_label ]] && printf 'vscode=%s\n' "$vscode_label"
    true
  } > "$dir/theme.conf" || { note "could not write theme.conf"; pause; return; }

  if (( ${#vicinae_files[@]} > 0 )); then
    save_vicinae_files "$dir/vicinae" "${vicinae_files[@]}" || { note "could not copy the vicinae theme"; pause; return; }
  fi
  if [[ -n $colors ]]; then
    cp -a "$colors" "$dir/$name.colors" || { note "could not copy the color scheme"; pause; return; }
  fi
  if (( ${#wall_files[@]} > 0 )); then
    mkdir -p "$dir/wallpapers" || { note "could not create the wallpaper folder"; pause; return; }
    for file in "${wall_files[@]}"; do
      cp -a "$file" "$dir/wallpapers/" || { note "could not copy a wallpaper"; pause; return; }
    done
  fi
  if [[ -d $gtk ]]; then
    mkdir -p "$dir/gtk" || { note "could not create the gtk folder"; pause; return; }
    cp -a "$gtk"/. "$dir/gtk/" || { note "could not copy the gtk theme"; pause; return; }
  fi
  if [[ -n $vsix ]]; then
    mkdir -p "$dir/vscode" || { note "could not create the vscode folder"; pause; return; }
    cp -a "$vsix" "$dir/vscode/" || { note "could not copy the vsix"; pause; return; }
  fi
  if [[ -n $firefox ]]; then
    mkdir -p "$dir/firefox" || { note "could not create the firefox folder"; pause; return; }
    cp -a "$firefox" "$dir/firefox/" || { note "could not copy the firefox addon"; pause; return; }
  fi
  if [[ -n $helium ]]; then
    if ! py extract-archive "$helium" "$dir/helium"; then
      mkdir -p "$dir/helium"
      cp -a "$helium" "$dir/helium/" || { note "could not copy the helium addon"; pause; return; }
    fi
  fi

  echo
  note "created $dir"
  echo
  pause
}

show_menu() {
  clear 2>/dev/null || true
  cat <<'EOF'
 ░▒▓███████▓▒░▒▓█▓▒░░▒▓█▓▒░▒▓████████▓▒░▒▓███████▓▒░░▒▓█▓▒░░▒▓█▓▒░▒▓████████▓▒░▒▓███████▓▒░░▒▓███████▓▒░  
